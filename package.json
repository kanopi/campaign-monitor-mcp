{
  "name": "@kanopi/campaign-monitor-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server exposing the full Campaign Monitor (createsend) v3.3 API",
  "type": "module",
  "license": "MIT",
  "author": "Sean Dietrich<sean@kanopi.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "campaign-monitor",
    "createsend",
    "email-marketing",
    "claude",
    "ai"
  ],
  "homepage": "https://github.com/kanopi/campaign-monitor-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanopi/campaign-monitor-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kanopi/campaign-monitor-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "campaign-monitor-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "auth": "node --import tsx src/oauth-setup.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
