# Campaign Monitor MCP — environment configuration

# === Recommended auth: API key (HTTP Basic) ===
# The simplest option. Find it in Campaign Monitor under your account name
# (top-right) > Account settings > API keys. Use the account-level key for
# full access to the `account` and `clients` tools.
# This is used automatically unless the OAuth variables below are all set.
CM_API_KEY=

# --- Optional: limit which tool categories are exposed (comma-separated) ---
# Default = all. Valid: account, clients, campaigns, lists, segments,
#                       subscribers, templates, transactional, journeys
# CM_ENABLED_CATEGORIES=account,clients,campaigns,lists

# ============================================================================
# OPTIONAL: OAuth 2.0 (alternative to the API key above)
# ----------------------------------------------------------------------------
# Only needed if you prefer scoped, revocable tokens. Register an OAuth app in
# Campaign Monitor (Integrations > OAuth Registration), then run `npm run auth`
# once to obtain a refresh token. When all three of CLIENT_ID/SECRET/REFRESH
# are set, they take precedence over CM_API_KEY.
# CM_CLIENT_ID=
# CM_CLIENT_SECRET=
# CM_REFRESH_TOKEN=

# Redirect URI registered with your OAuth app. Must match exactly.
# CM_REDIRECT_URI=http://127.0.0.1:53682/callback

# OAuth scopes requested during `npm run auth` (comma-separated).
# Valid: ManageLists, CreateCampaigns, SendCampaigns, ImportSubscribers,
#        ManageTemplates, ViewReports, ViewTransactional, SendTransactional,
#        ManageSubscriberData, AdminManagement
# CM_SCOPES=ManageLists,CreateCampaigns,SendCampaigns,ImportSubscribers,ManageTemplates,ViewReports,ViewTransactional,SendTransactional,ManageSubscriberData

# Path to the OAuth token store file (default ~/.campaign-monitor-mcp/tokens.json)
# CM_TOKEN_STORE=
