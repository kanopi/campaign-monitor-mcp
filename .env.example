# Campaign Monitor MCP — environment configuration
#
# Primary auth: OAuth 2.0 (recommended). Run `npm run auth` once to obtain a
# refresh token, then paste it below. The server auto-refreshes access tokens.
CM_CLIENT_ID=
CM_CLIENT_SECRET=
CM_REFRESH_TOKEN=

# Redirect URI registered with your Campaign Monitor OAuth app.
# Must match exactly. Default works for the local `npm run auth` bootstrap.
CM_REDIRECT_URI=http://127.0.0.1:53682/callback

# OAuth scopes requested during `npm run auth` (comma-separated).
# Default requests full access. Trim to least-privilege if desired.
# Valid: ManageLists, CreateCampaigns, SendCampaigns, ImportSubscribers,
#        ManageTemplates, ViewReports, ViewTransactional, SendTransactional,
#        ManageSubscriberData, AdminManagement
CM_SCOPES=ManageLists,CreateCampaigns,SendCampaigns,ImportSubscribers,ManageTemplates,ViewReports,ViewTransactional,SendTransactional,ManageSubscriberData

# --- Fallback auth: API key (HTTP Basic) ---
# If set AND no OAuth refresh token is present, the server uses this instead.
# Find it under Account Settings > API keys in Campaign Monitor.
# CM_API_KEY=

# --- Optional ---
# Limit which tool categories are exposed (comma-separated). Default = all.
# Valid: account, clients, campaigns, lists, segments, subscribers,
#        templates, transactional, journeys
# CM_ENABLED_CATEGORIES=account,clients,campaigns,lists
